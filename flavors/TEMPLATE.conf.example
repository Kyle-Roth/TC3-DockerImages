# ---------------------------------------------------------------------------
# HOW TO ADD A NEW CONTAINER FLAVOR
#
# 1. Copy this file:   cp flavors/TEMPLATE.conf.example flavors/<name>.conf
#    <name> becomes the image tag:  <registry>/<owner>/tc31-xar:<name>
#    (lowercase letters, digits, '-' and '.' only)
#
# 2. Find package names in the Beckhoff repo:
#        make discover-packages                       # all TwinCAT packages
#        scripts/discover-packages.sh tf6             # filter by regex
#        PLATFORM=linux/arm64 make discover-packages  # check arm64 availability
#
# 3. Fill in the variables below, then test locally:
#        make list-flavors                    # shows the resolved package list
#        make build-image  FLAVOR=<name>
#        make verify-image FLAVOR=<name>      # credential leak scan
#
# 4. Commit. CI builds the new flavor automatically as its own matrix job,
#    and the 'all' flavor picks up its packages automatically too.
#
# This file is plain POSIX sh, sourced by scripts/lib.sh. Only *.conf files
# are flavors, so this .example file is ignored.
# ---------------------------------------------------------------------------

# One-line description, shown by `make list-flavors`
DESCRIPTION="TwinCAT 3.1 XAR runtime + <something>"

# Space-separated apt packages. Always include the runtime (tc31-xar-um).
PACKAGES="tc31-xar-um adstool tfXXXX-package-name"

# Optional: also include the PACKAGES of other flavors ("*" = every flavor
# that doesn't itself use INCLUDE_FLAVORS). Nesting is not supported.
# INCLUDE_FLAVORS="basic motion"

# Target platforms for the pushed image. Use "linux/amd64" alone if a
# package has no arm64 build (check with PLATFORM=linux/arm64 above).
PLATFORMS="linux/amd64,linux/arm64"
